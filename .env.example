ES_URL=http://localhost:9200
ES_INDEX=tagged_feedback
ES_USERNAME=
ES_PASSWORD=
ES_VERIFY_CERTS=false

# OpenAI-compatible LLM endpoint. DeepSeek default:
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# Alternative env name also supported:
DEEPSEEK_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
# Report generation uses a shorter best-effort LLM call, then falls back to deterministic wording.
LLM_REPORT_ENABLED=false
LLM_REPORT_TIMEOUT_SECONDS=12
LLM_REPORT_MAX_RETRIES=0
LLM_REPORT_MAX_TOKENS=2500

IMPORT_BATCH_SIZE=500
OUTPUTS_DIR=outputs
LOGS_DIR=logs
