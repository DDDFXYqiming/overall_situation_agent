ES_URL=http://localhost:9200
ES_INDEX=tagged_feedback
ES_USERNAME=
ES_PASSWORD=
ES_VERIFY_CERTS=false

# OpenAI-compatible LLM endpoint. DeepSeek default:
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# Alternative env name also supported:
DEEPSEEK_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

OUTPUTS_DIR=outputs
LOGS_DIR=logs
