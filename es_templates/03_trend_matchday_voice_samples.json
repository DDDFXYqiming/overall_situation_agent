{
  "question": "像2026-03-07、2026-03-14这类赛事日，样例原声摘要和主要问题是怎么取出来的？",
  "description": "在日聚合中增加 top_hits，抽取赛事日样本，结合当日 Top3 三级问题生成样例摘要。",
  "dsl": {
    "size": 0,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "service_time": {
                "gte": "{{start_date}}",
                "lt": "{{end_date_exclusive}}"
              }
            }
          },
          {
            "exists": {
              "field": "primary_labels"
            }
          }
        ]
      }
    },
    "aggs": {
      "daily": {
        "date_histogram": {
          "field": "service_time",
          "calendar_interval": "day",
          "format": "yyyy-MM-dd",
          "min_doc_count": 0
        },
        "aggs": {
          "negative": {
            "filter": {
              "terms": {
                "scene_emotion": [
                  "愤怒",
                  "失望",
                  "焦虑",
                  "不满",
                  "烦躁"
                ]
              }
            }
          },
          "top_tertiary": {
            "terms": {
              "field": "tertiary_labels",
              "size": 3
            }
          },
          "sample_hits": {
            "top_hits": {
              "size": 3,
              "_source": [
                "service_time",
                "content",
                "customer_key_appeal",
                "scene_emotion",
                "primary_labels",
                "secondary_labels",
                "tertiary_labels",
                "operation_action",
                "biz_member_cluster",
                "match_label"
              ]
            }
          }
        }
      }
    }
  }
}
