{
  "question": "2026年3月异动最高的是哪天、日环比增幅多少，当天主要问题是什么？",
  "description": "复用日聚合中的主要一级、二级、三级问题、服务类型和会员/业务聚类，按 day_over_day_growth >= 50% 且 count >= 5 筛选异动节点。",
  "dsl": {
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "service_time": {
                "gte": "{{start_date}}",
                "lt": "{{end_date_exclusive}}"
              }
            }
          },
          {
            "exists": {
              "field": "primary_labels"
            }
          }
        ]
      }
    },
    "aggs": {
      "daily": {
        "date_histogram": {
          "field": "service_time",
          "calendar_interval": "day",
          "format": "yyyy-MM-dd",
          "min_doc_count": 0
        },
        "aggs": {
          "negative": {
            "filter": {
              "terms": {
                "scene_emotion": [
                  "愤怒",
                  "失望",
                  "焦虑",
                  "不满",
                  "烦躁"
                ]
              }
            }
          },
          "top_primary": {
            "terms": {
              "field": "primary_labels",
              "size": 3
            }
          },
          "top_secondary": {
            "terms": {
              "field": "secondary_labels",
              "size": 3
            }
          },
          "top_tertiary": {
            "terms": {
              "field": "tertiary_labels",
              "size": 3
            }
          },
          "top_service_type": {
            "terms": {
              "field": "scene_service_type",
              "size": 3
            }
          },
          "top_member_cluster": {
            "terms": {
              "field": "biz_member_cluster",
              "size": 3
            }
          }
        }
      }
    }
  }
}
