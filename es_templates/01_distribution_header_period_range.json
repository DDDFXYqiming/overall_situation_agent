{
  "question": "这份报告的数据周期起止日期分别是什么？",
  "description": "取查询周期内 service_time 的最小值与最大值，用于生成“数据周期：YYYY-MM-DD 至 YYYY-MM-DD”。",
  "dsl": {
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "service_time": {
                "gte": "{{start_date}}",
                "lt": "{{end_date_exclusive}}"
              }
            }
          }
        ]
      }
    },
    "aggs": {
      "period_min": {
        "min": {
          "field": "service_time"
        }
      },
      "period_max": {
        "max": {
          "field": "service_time"
        }
      }
    }
  }
}
