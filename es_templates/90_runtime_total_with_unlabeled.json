{
  "question": "运行时：统计当前日期范围内全量服务数据总量。",
  "description": "报告生成运行时模板。用于 total_with_unlabeled，包含未标注数据。",
  "dsl": {
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "service_time": {
                "gte": "{{start_date}}",
                "lt": "{{end_date_exclusive}}"
              }
            }
          }
        ]
      }
    }
  }
}
