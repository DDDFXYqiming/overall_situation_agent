          "bool": {
            "filter": [
              {
                "range": {
                  "service_time": {
                    "gte": "{{start_date}}",
                    "lt": "{{end_date_exclusive}}"
                  }
                }
              },
              {
                "exists": {
                  "field": "primary_labels"
                }
              }
            ]
          }
        },
        "aggs": {
          "daily": {
            "date_histogram": {
              "field": "service_time",
              "calendar_interval": "day",
              "format": "yyyy-MM-dd",
              "min_doc_count": 0
            },
            "aggs": {
              "negative": {
                "filter": {
                  "terms": {
                    "scene_emotion": [
                      "愤怒",
                      "厌恶",
                      "恐惧",
                      "悲伤"
                    ]
                  }
                }
              },
              "top_tertiary": {
                "terms": {
                  "field": "tertiary_labels",
                  "size": 3
                }
              }
            }
          }
        }
      }
    },
    {
