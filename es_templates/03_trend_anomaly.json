{
  "template_group": "03_trend_anomaly",
  "description": "每日趋势、赛事日样例和异动节点模板。",
  "templates": [
    {
      "id": "03_trend_daily_aggregation",
      "visibility": "llm",
      "question": "2026年3月按天看，问题量、负向占比、主要一级/二级/三级问题、服务类型和会员类型每天分别是什么？",
      "description": "按天统计已标注服务数据，并在每天聚合负向情绪、主要一级/二级/三级问题、服务类型和会员/业务类型。",
      "dsl": {
        "size": 0,
        "track_total_hits": true,
        "query": {
          "bool": {
            "filter": [
              {
                "range": {
                  "service_time": {
                    "gte": "{{start_date}}",
                    "lt": "{{end_date_exclusive}}"
                  }
                }
              },
              {
                "exists": {
                  "field": "primary_labels"
                }
              }
            ]
          }
        },
        "aggs": {
          "daily": {
            "date_histogram": {
              "field": "service_time",
              "calendar_interval": "day",
              "format": "yyyy-MM-dd",
              "min_doc_count": 0
            },
            "aggs": {
              "negative": {
                "filter": {
                  "terms": {
                    "scene_emotion": [
                      "愤怒",
                      "厌恶",
                      "恐惧",
                      "悲伤"
                    ]
                  }
                }
              },
              "top_primary": {
                "terms": {
                  "field": "primary_labels",
                  "size": 3
                }
              },
              "top_secondary": {
                "terms": {
                  "field": "secondary_labels",
                  "size": 3
                }
              },
              "top_tertiary": {
                "terms": {
                  "field": "tertiary_labels",
                  "size": 3
                }
              },
              "top_service_type": {
                "terms": {
                  "field": "scene_service_type",
                  "size": 3
                }
              },
              "top_member_cluster": {
                "terms": {
                  "field": "biz_member_cluster",
                  "size": 3
                }
              }
            }
          }
        }
      }
    },
    {
