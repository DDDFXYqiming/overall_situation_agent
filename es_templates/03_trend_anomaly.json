            "date_histogram": {
              "field": "service_time",
              "calendar_interval": "day",
              "format": "yyyy-MM-dd",
              "min_doc_count": 0
            },
            "aggs": {
              "negative": {
                "filter": {
                  "terms": {
                    "scene_emotion": [
                      "愤怒",
                      "厌恶",
                      "恐惧",
                      "悲伤"
                    ]
                  }
                }
              },
              "top_tertiary": {
                "terms": {
                  "field": "tertiary_labels",
                  "size": 3
                }
              },
              "sample_hits": {
                "top_hits": {
                  "size": 3,
                  "_source": [
                    "service_time",
                    "content",
                    "customer_key_appeal",
                    "scene_emotion",
                    "primary_labels",
                    "secondary_labels",
                    "tertiary_labels",
                    "operation_action",
                    "biz_member_cluster",
                    "match_label"
                  ]
                }
              }
            }
          }
        }
      }
    },
