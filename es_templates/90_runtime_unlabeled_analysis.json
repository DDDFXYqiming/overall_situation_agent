{
  "question": "运行时：统计未标注服务数据的结构。",
  "description": "报告生成运行时模板。保持与重构前 run_unlabeled_analysis DSL 一致。",
  "dsl": {
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "service_time": {
                "gte": "{{start_date}}",
                "lt": "{{end_date_exclusive}}"
              }
            }
          },
          {
            "bool": {
              "must_not": [
                {
                  "exists": {
                    "field": "primary_labels"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "aggs": {
      "emotion": {
        "terms": {
          "field": "scene_emotion",
          "size": 10
        }
      },
      "biz_member_cluster": {
        "terms": {
          "field": "biz_member_cluster",
          "size": 10
        }
      },
      "province": {
        "terms": {
          "field": "province_name",
          "size": 15
        }
      },
      "service_type": {
        "terms": {
          "field": "scene_service_type",
          "size": 5
        }
      },
      "csp_name": {
        "terms": {
          "field": "csp_name",
          "size": 10
        }
      },
      "operation_action": {
        "terms": {
          "field": "operation_action",
          "size": 10
        }
      },
      "latent_need": {
        "terms": {
          "field": "latent_need.keyword",
          "size": 10,
          "exclude": [
            "无",
            "不适用",
            "{}"
          ]
        }
      },
      "customer_key_appeal": {
        "terms": {
          "field": "customer_key_appeal.keyword",
          "size": 10
        }
      },
      "has_refund_demand": {
        "terms": {
          "field": "has_refund_demand",
          "size": 5
        }
      },
      "has_escalation": {
        "terms": {
          "field": "has_escalation",
          "size": 5
        }
      },
      "insight_dimension": {
        "terms": {
          "field": "insight_dimension",
          "size": 10
        }
      },
      "time_period": {
        "terms": {
          "field": "time_period",
          "size": 8
        }
      },
      "samples": {
        "top_hits": {
          "size": 15,
          "_source": [
            "gd_identity",
            "content",
            "cs_reply",
            "customer_key_appeal",
            "operation_action",
            "latent_need",
            "latent_need_reason",
            "biz_member_cluster",
            "province_name",
            "scene_emotion",
            "scene_service_type",
            "csp_name",
            "has_refund_demand",
            "has_escalation",
            "insight_dimension",
            "time_period"
          ]
        }
      }
    }
  }
}
