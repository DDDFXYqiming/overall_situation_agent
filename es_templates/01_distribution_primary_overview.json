{
  "question": "一级问题概览里，业务体验、使用体验、内容体验、营销活动各有多少条、占比多少？",
  "description": "统计报告展示的业务体验、使用体验、内容体验、营销活动四类一级问题，提及量取 buckets.doc_count，占比以总服务数据量为分母。",
  "dsl": {
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "service_time": {
                "gte": "{{start_date}}",
                "lt": "{{end_date_exclusive}}"
              }
            }
          },
          {
            "exists": {
              "field": "primary_labels"
            }
          }
        ]
      }
    },
    "aggs": {
      "primary_top4": {
        "terms": {
          "field": "primary_labels",
          "size": 4,
          "include": [
            "业务体验",
            "使用体验",
            "内容体验",
            "营销活动"
          ]
        }
      }
    }
  }
}
