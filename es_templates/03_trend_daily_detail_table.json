{
  "question": "2026年3月每日明细表里，每天的问题量、负向占比、是否赛事日和主要三级问题分别是什么？",
  "description": "复用日聚合结果生成日期、问题量、负向占比、赛事日和主要三级问题；异动标记由 growth >= 50% 且 count >= 5 计算得到。",
  "dsl": {
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "service_time": {
                "gte": "{{start_date}}",
                "lt": "{{end_date_exclusive}}"
              }
            }
          },
          {
            "exists": {
              "field": "primary_labels"
            }
          }
        ]
      }
    },
    "aggs": {
      "daily": {
        "date_histogram": {
          "field": "service_time",
          "calendar_interval": "day",
          "format": "yyyy-MM-dd",
          "min_doc_count": 0
        },
        "aggs": {
          "negative": {
            "filter": {
              "terms": {
                "scene_emotion": [
                  "愤怒",
                  "失望",
                  "焦虑",
                  "不满",
                  "烦躁"
                ]
              }
            }
          },
          "top_tertiary": {
            "terms": {
              "field": "tertiary_labels",
              "size": 3
            }
          }
        }
      }
    }
  }
}
