{
  "question": "2026年3月每日问题量和负向占比里，峰值日、负向峰值日、赛事日合计和最高异动增幅分别是多少？",
  "description": "由日聚合结果派生峰值、负向峰值、赛事日合计和异动最高增幅；赛事日需要与赛程表日期匹配。",
  "dsl": {
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "service_time": {
                "gte": "{{start_date}}",
                "lt": "{{end_date_exclusive}}"
              }
            }
          },
          {
            "exists": {
              "field": "primary_labels"
            }
          }
        ]
      }
    },
    "aggs": {
      "daily": {
        "date_histogram": {
          "field": "service_time",
          "calendar_interval": "day",
          "format": "yyyy-MM-dd",
          "min_doc_count": 0
        },
        "aggs": {
          "negative": {
            "filter": {
              "terms": {
                "scene_emotion": [
                  "愤怒",
                  "失望",
                  "焦虑",
                  "不满",
                  "烦躁"
                ]
              }
            }
          }
        }
      }
    }
  }
}
