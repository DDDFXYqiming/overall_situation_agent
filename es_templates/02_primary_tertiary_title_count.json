{
  "question": "一级标签“业务体验”下面，三级标签“退订困难/自动续费争议”的数量和占该一级问题比例是多少？",
  "description": "同一条 ES 查询同时返回指定一级标签 {{primary_label}} 的总量和指定三级标签 {{tertiary_label}} 的数量。",
  "dsl": {
    "size": 0,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "service_time": {
                "gte": "{{start_date}}",
                "lt": "{{end_date_exclusive}}"
              }
            }
          },
          {
            "exists": {
              "field": "primary_labels"
            }
          }
        ]
      }
    },
    "aggs": {
      "primary_total": {
        "filter": {
          "term": {
            "primary_labels": "{{primary_label}}"
          }
        }
      },
      "tertiary_count": {
        "filter": {
          "bool": {
            "must": [
              {
                "term": {
                  "primary_labels": "{{primary_label}}"
                }
              },
              {
                "term": {
                  "tertiary_labels": "{{tertiary_label}}"
                }
              }
            ]
          }
        }
      }
    }
  }
}
