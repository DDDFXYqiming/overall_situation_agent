{
  "question": "运行时：统计未标注服务数据的每日趋势。",
  "description": "报告生成运行时模板。保持与重构前 run_unlabeled_trend_analysis DSL 一致。",
  "dsl": {
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "service_time": {
                "gte": "{{start_date}}",
                "lt": "{{end_date_exclusive}}"
              }
            }
          },
          {
            "bool": {
              "must_not": [
                {
                  "exists": {
                    "field": "primary_labels"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "aggs": {
      "daily": {
        "date_histogram": {
          "field": "service_time",
          "calendar_interval": "day",
          "format": "yyyy-MM-dd",
          "min_doc_count": 1
        },
        "aggs": {
          "emotion": {
            "terms": {
              "field": "scene_emotion",
              "size": 5
            }
          },
          "top_appeal": {
            "terms": {
              "field": "customer_key_appeal.keyword",
              "size": 3
            }
          },
          "negative": {
            "filter": {
              "terms": {
                "scene_emotion": [
                  "愤怒",
                  "失望",
                  "焦虑",
                  "不满",
                  "烦躁"
                ]
              }
            }
          }
        }
      }
    }
  }
}
