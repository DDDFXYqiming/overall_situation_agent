{
  "question": "运行时：获取报告三级证据抽样的三级标签桶。",
  "description": "报告证据运行时模板。可传 labels 限定三级标签列表；为空时取 TopN。",
  "dsl": {
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "service_time": {
                "gte": "{{start_date}}",
                "lt": "{{end_date_exclusive}}"
              }
            }
          },
          {
            "exists": {
              "field": "primary_labels"
            }
          }
        ]
      }
    },
    "aggs": {
      "tertiary_top": {
        "terms": {
          "field": "tertiary_labels",
          "size": "{{top_n}}",
          "include": "{{labels}}"
        }
      }
    }
  }
}
